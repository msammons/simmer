{
  "manifest_version": 3,
  "name": "Simmer for Safeway",
  "version": "0.4.0",
  "description": "Fills your Safeway cart from the Simmer list. You check out on Safeway yourself.",
  "permissions": ["sidePanel", "storage", "scripting", "tabs", "clipboardWrite"],
  "host_permissions": ["https://www.safeway.com/*", "https://*.vercel.app/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Simmer", "default_icon": { "128": "icon.png" } },
  "icons": { "128": "icon.png" }
}
