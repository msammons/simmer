{
  "manifest_version": 3,
  "name": "Simmer",
  "version": "1.1.0",
  "description": "Simmer's hands in this Chrome: does Simmer's store searches and cart changes, for the phone and for Simmer in this panel. You check out yourself.",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.safeway.com/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Simmer",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  }
}
