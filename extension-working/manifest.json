{
  "manifest_version": 3,
  "name": "Simmer",
  "version": "26.11.23.3",
  "description": "Finds groceries and fills your Safeway cart for Simmer.",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://www.safeway.com/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Simmer",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  }
}
