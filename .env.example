# Copy to .env.local for local dev; set the same names in Vercel for production.

# Google AI Studio key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# What each phone enters once
HOUSEHOLD_PASSCODE=

# Google Sheet. Leave blank to use data/*.csv (local dev only).
# Optional: the Sheet's id is in src/lib/google/sheets.ts. Set this only to point at a different Sheet.
SHEET_ID=
# The service account key file's entire JSON, on one line
GOOGLE_SERVICE_ACCOUNT_JSON=
